-- Generated by research/signed_approach/export_data.py; Lean checking is required.
import Heraclitus.SignedApproach
import Heraclitus.ApproachWordData

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

namespace Heraclitus.SignedApproachData
open OutgoingWord ReturnBridge SignedApproach

def catalogue : List ApproachWord.Checked := ApproachWordData.catalogue

theorem labels_complete : catalogue.map (fun c => c.row.label) =
    (List.range 36).map (fun i => i+40) := ApproachWordData.labels_complete

theorem all_exponents : ∀ c ∈ catalogue, ∀ (t : Nat) (C : Int)
    (side : Bool) (other : RayBoundary),
    2*C+1=(7^(c.row.exponent t) : Nat) → 3*c.row.scale t-200 ≤ other.front →
    ∃ b : SignedBlock (liftRay side C other (c.row.start (c.row.scale t)))
      (liftRay side C other (c.row.finish (c.row.scale t))),
      b.word=(c.row.word (c.row.scale t)).map (embedRay side C) ∧
      (b.word.length : Int)=c.row.moves (c.row.scale t) := by
  intro c _hc t C side other radius filled
  exact SignedApproach.all_exponents c t C side other radius filled


/-- Whole-state composition for phase 40, at every exponent in its class. -/
theorem phase40 (t : Nat) (C : Int)
    (radius : 2*C+1=(7^(ApproachWordData.row40.exponent t) : Nat)) :
    ∃ q r : Nat, ∃ b : SignedBlock
      (PostLadderData.input40.before.entrance.outgoing.inner.initial.toState C)
      (liftRay (!PostLadderData.input40.before.entrance.outgoing.row.positive) C
        (farBoundary PostLadderData.input40.before.entrance.outgoing q)
        (ApproachWordData.row40.finish (ApproachWordData.row40.scale t))),
      (b.word.length : Int)=PostLadderData.input40.before.moves t q+PostLadderData.input40.transferMoves r+
        ApproachWordData.row40.moves (ApproachWordData.row40.scale t) ∧
      ApproachWordData.row40.scale t=PostLadderData.input40.transfer.original.transfer.target+
        (r : Int)*PostLadderData.input40.transfer.original.transfer.modulus ∧
      3*ApproachWordData.row40.scale t-200 ≤ (farBoundary PostLadderData.input40.before.entrance.outgoing q).front ∧
      PostLadderData.input40.before.CycleIndex t q := by
  obtain ⟨q, r, first, count, spacing, filled, index⟩ :=
    PostLadderData.checked40.all_exponents t C radius
  have last := SignedApproach.all_exponents ApproachWordData.checked40 t C
    (!PostLadderData.input40.before.entrance.outgoing.row.positive)
    (farBoundary PostLadderData.input40.before.entrance.outgoing q) radius filled
  obtain ⟨last, _word, lastCount⟩ := last
  let tail := alignInput last (congrArg
    (liftRay (!PostLadderData.input40.before.entrance.outgoing.row.positive) C
      (farBoundary PostLadderData.input40.before.entrance.outgoing q)) (ApproachWordData.input40_all t))
  refine ⟨q, r, first.then tail, ?_, spacing, filled, index⟩
  change (((first.word ++ last.word).length : Nat) : Int)=_
  rw [List.length_append, Int.natCast_add, count, lastCount]
  rfl


