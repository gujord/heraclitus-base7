theorem labels_complete : catalogue.map (fun c => c.checked.link.approach.row.label) =
    (List.range 36).map (fun i => i+40) := by decide

theorem exponents_complete : catalogue.map (fun c => c.checked.link.approach.row.leastExponent) =
    [40, 41] ++ (List.range 34).map (fun i => i+6) := by decide

theorem all_inputs : ∀ c ∈ catalogue, ∀ (t q : Nat) (C : Int),
    c.checked.link.phase.CycleIndex t q →
    liftRay (!c.checked.link.phase.entrance.outgoing.row.positive) C
      (farBoundary c.checked.link.phase.entrance.outgoing q)
      (c.checked.link.approach.row.finish (c.checked.link.approach.row.scale t)) =
        c.checked.link.outer.initial.toState (C+3*c.checked.link.approach.row.scale t) := by
  intro c _hc t q C index
  exact c.checked.input_all t q C index

theorem all_closures : ∀ c ∈ catalogue, ∀ D,
    c.checked.link.outer.final.toState D=c.checked.link.following.toState D := by
  intro c _hc D
  exact c.checked.closure D

theorem all_transitions : ∀ c ∈ catalogue, ∀ (t : Nat) (C : Int),
    2*C+1=(7^(c.checked.link.approach.row.exponent t) : Nat) →
    ∃ b : SignedBlock (c.checked.link.phase.entrance.outgoing.inner.initial.toState C)
      (c.checked.link.following.toState (C+3*c.checked.link.approach.row.scale t)),
      b.word.length=6*7^(c.checked.link.approach.row.exponent t) := by
  intro c _hc t C radius
  exact c.exact t C radius

theorem all_filled : ∀ c ∈ catalogue, ∀ C x,
    -C+37 ≤ x → x ≤ C-37 →
    (c.checked.link.phase.entrance.outgoing.inner.initial.toState C).used x := by
  intro c _hc C x low high
  exact c.checked.inner_filled C x low high

end Heraclitus.OuterBoundaryData
