theorem phase_least : ∀ i : Fin 36,
    (phase i).entrance.outgoing.row.leastExponent=i.val+6 := by decide

theorem phase_exponent (i : Fin 36) (t : Nat) :
    (phase i).exponent t=exponent i t := by
  unfold Phase.exponent exponent
  rw [phase_least]

