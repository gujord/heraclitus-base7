theorem bottom_ladder_bound (b : LadderBottom.CheckedBottom)
    (member : b ∈ LadderBottomData.catalogue) : LadderBound 53 b.bottom.ladder.ladder := by
  apply all_ladders b.bottom.ladder
  rw [← LadderBottomData.ladders_agree]
  exact List.mem_map.mpr ⟨b,member,rfl⟩

